# Copy to .env.local for local dev; add the same values in Vercel → Project → Settings → Environment Variables.

# Public URL of the app (no trailing slash). Local: http://localhost:3000  Prod: https://your-app.vercel.app
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail push notifications (Pub/Sub topic full name), e.g. projects/erg-dashboard/topics/gmail-inbox
GMAIL_PUBSUB_TOPIC=
# Random secret; the Pub/Sub push URL is  {APP_URL}/api/gmail/webhook?token=THIS_VALUE
# One topic + one push subscription serves every connected account (each notification names its mailbox).
GMAIL_WEBHOOK_TOKEN=

# Supabase (Project Settings → API). The service-role key is secret: server only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Who may sign in to the dashboard (comma-separated Google accounts), e.g. Leonel's Gmail.
# Once signed in you can add any number of other Gmail accounts with "Add Gmail account".
ALLOWED_EMAILS=
# Encrypts every account's Google refresh token at rest (AES-256-GCM). 32 bytes:   openssl rand -base64 32
# Keep it secret and don't change it later (changing it means reconnecting every account).
TOKEN_ENCRYPTION_KEY=
# 32+ random characters; signs the login cookie.   Generate: openssl rand -hex 32
SESSION_SECRET=
# Random secret Vercel Cron sends as "Authorization: Bearer ..." (Vercel sets this header automatically from CRON_SECRET)
CRON_SECRET=

# Optional
# SENDER_NAME=Leonel - The Event Rental Guys
# DRAFT_LOOKBACK_DAYS=3            # only auto-draft emails received within this many days
# NEXT_PUBLIC_TIMEZONE=America/Los_Angeles
